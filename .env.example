# ── Core ──────────────────────────────────────────────────────────────
# Public site URL (no trailing slash). Used in emails and receipts.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_NAME=DSB Digital Library

# 32+ random characters. Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# ── Database (libSQL / SQLite) ────────────────────────────────────────
# Local development: file:.data/dsb.db
# Production (Turso): libsql://your-db.turso.io  + TURSO_AUTH_TOKEN
DATABASE_URL=file:.data/dsb.db
TURSO_AUTH_TOKEN=

# ── Private file storage ──────────────────────────────────────────────
# local  = filesystem under .data/storage (development)
# netlify = private Netlify Blobs (production on Netlify)
STORAGE_DRIVER=local
NETLIFY_BLOBS_SITE_ID=
NETLIFY_BLOBS_TOKEN=

# ── Admin bootstrap (used by `npm run seed`) ─────────────────────────
ADMIN_NAME=DSB Administrator
ADMIN_EMAIL=admin@dsbdigitallibrary.com
ADMIN_PASSWORD=ChangeThisAdminPass#2026

# ── Razorpay (server secrets — never expose) ─────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Google sign-in (optional) ────────────────────────────────────────
# Exact callback registered in Google Cloud Console:
# Local:      http://localhost:3000/api/auth/google/callback
# Production: https://<your-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# ── Email (optional; SMTP) ───────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DSB Digital Library <no-reply@dsbdigitallibrary.com>"
